{
  "agent_id": "browser-file-agent-v1",
  "version": "1.0.0",
  "session": {
    "headless": true,
    "locale": "en-US",
    "timezone": "Asia/Dhaka",
    "storage_state_path": "./profiles/default/storage.json"
  },
  "task_profiles": {
    "scrape": {
      "goal": "Extract text, links, tables or downloadable assets from active page",
      "allowed_actions": ["click", "type", "navigate", "scroll", "extract_text"],
      "fallback_chain": ["dom_snapshot", "viewport_screenshot_ocr"]
    },
    "create_save_edit": {
      "goal": "Create, save or edit files via browser editors, download zones or upload fields",
      "allowed_actions": ["click", "type", "upload_file", "download_file", "save_as"],
      "fallback_chain": ["dom_snapshot", "coordinate_click", "paste_content"]
    }
  },
  "file_policy": {
    "allowed_extensions": [".txt", ".py", ".js", ".ts", ".json", ".csv", ".md", ".zip", ".html", ".css"],
    "max_download_mb": 50,
    "output_dir": "./extracted_files",
    "auto_rename_duplicates": true,
    "verify_integrity": false
  },
  "llm_routing": {
    "endpoint": "${FREEAPI_PROXY_URL}",
    "auth_template": "Bearer ${FREEAPI_AGENT_KEY}",
    "model_fallback": ["claude-sonnet-4-20250514", "gpt-4o-mini", "deepseek-v3"],
    "temperature": 0.2,
    "max_tokens": 1024
  }
}
