# FreeLLMAPI & Agent Core
FREEAPI_PROXY_URL=http://localhost:8000/v1
FREEAPI_AGENT_KEY=your_api_key_here
BROWSER_HEADLESS=true
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=Asia/Dhaka

# Storage & Output
BROWSER_PROFILE_DIR=./profiles/default
AGENT_OUTPUT_DIR=./extracted_files

# Logging
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=true
